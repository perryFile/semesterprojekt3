close all;
clear all;

% DTMF tone generator
N = 1024;
fs = 8000;
t = (0:1:N-1)/fs; % Sampling rate and time vector

k697 = round(697/fs*N);
k770 = round(770/fs*N);
k852 = 852/fs*N;
k941 = 941/fs*N;
k1209 = 1209/fs*N;
k1336 = 1336/fs*N;
k1477 = 1477/fs*N;
k1633 = 1633/fs*N;

% DTMF detector (use Goertzel algorithm)
a697  = [1 -2*cos(2*pi*k697/N) 1];
a770  = [1 -2*cos(2*pi*k770/N) 1];
a852  = [1 -2*cos(2*pi*k852/N) 1];
a941  = [1 -2*cos(2*pi*k941/N) 1];
a1209 = [1 -2*cos(2*pi*k1209/N) 1];
a1336 = [1 -2*cos(2*pi*k1336/N) 1];
a1477 = [1 -2*cos(2*pi*k1477/N) 1];
a1633 = [1 -2*cos(2*pi*k1633/N) 1];


% Filter bank frequency responses
[w1, f] = freqz(1, a697, 512, fs);
[w2, f] = freqz(1, a770, 512, fs);
[w3, f] = freqz(1, a852, 512, fs);
[w4, f] = freqz(1, a941, 512, fs);
[w5, f] = freqz(1, a1209, 512, fs);
[w6, f] = freqz(1, a1336, 512, fs);
[w7, f] = freqz(1, a1477, 512, fs);

subplot(2,1,1);
plot(f,abs(w1),f,abs(w2),f,abs(w3), ...
     f,abs(w4),f,abs(w5),f,abs(w6),f,abs(w7));
grid on;
xlabel('Frequency (Hz)');
ylabel('(a) Filter bank freq. responses');

% Filter bank bandpass filtering
y697  = filter(1, a697, yDTMF);
y770  = filter(1, a770, yDTMF);
y852  = filter(1, a852, yDTMF);
y941  = filter(1, a941, yDTMF);
y1209 = filter(1, a1209, yDTMF);
y1336 = filter(1, a1336, yDTMF);
y1477 = filter(1, a1477, yDTMF);

% Determine the absolute magnitudes of DFT coefficients
m(1) = sqrt(y697(206)^2 + y697(205)^2 - ...
    2*cos(2*pi*18/205)*y697(206)*y697(205));

m(2) = sqrt(y770(206)^2 + y770(205)^2 - ...
    2*cos(2*pi*20/205)*y770(206)*y770(205));

m(3) = sqrt(y852(206)^2 + y852(205)^2 - ...
    2*cos(2*pi*22/205)*y852(206)*y852(205));

m(4) = sqrt(y941(206)^2 + y941(205)^2 - ...
    2*cos(2*pi*24/205)*y941(206)*y941(205));

m(5) = sqrt(y1209(206)^2 + y1209(205)^2 - ...
    2*cos(2*pi*31/205)*y1209(206)*y1209(205));

m(6) = sqrt(y1336(206)^2 + y1336(205)^2 - ...
    2*cos(2*pi*34/205)*y1336(206)*y1336(205));

m(7) = sqrt(y1477(206)^2 + y1477(205)^2 - ...
    2*cos(2*pi*38/205)*y1477(206)*y1477(205));

% Convert the magnitudes of DFT coefficients
% to the single-side spectrum
m = 2*m/205;

% Determine the threshold
th = sum(m)/4;

% Plot the DTMF spectrum with the threshold
f = [697 770 852 941 1209 1336 1477];
f1 = [0 fs/2];
th = [th th];

subplot(2,1,2);
stem(f,m);
grid;
hold;
plot(f1,th);

xlabel('Frequency (Hz)');
ylabel('(b) Spectral values');

% Round to the binary pattern
m = round(m);

if isequal(m,[1 0 0 0 1 0 0])
    disp('Detected Key 1');
end
if isequal(m,[1 0 0 0 0 1 0])
    disp('Detected Key 2');
end
if isequal(m,[1 0 0 0 0 0 1])
    disp('Detected Key 3');
end
if isequal(m,[0 1 0 0 1 0 0])
    disp('Detected Key 4');
end
if isequal(m,[0 1 0 0 0 1 0])
    disp('Detected Key 5');
end
if isequal(m,[0 1 0 0 0 0 1])
    disp('Detected Key 6');
end
if isequal(m,[0 0 1 0 1 0 0])
    disp('Detected Key 7');
end
if isequal(m,[0 0 1 0 0 1 0])
    disp('Detected Key 8');
end
if isequal(m,[0 0 1 0 0 0 1])
    disp('Detected Key 9');
end
if isequal(m,[0 0 0 1 1 0 0])
    disp('Detected Key *');
end
if isequal(m,[0 0 0 1 0 1 0])
    disp('Detected Key 0');
end
if isequal(m,[0 0 0 1 0 0 1])
    disp('Detected Key #');
end
